+!projects/mouse_demo/keil5/out/.gitkeep
+projects/mouse_demo/keil5/out_boot/*
+!projects/mouse_demo/keil5/out_boot/.gitkeep
+projects/mouse_demo/keil5/_build/*
+!projects/mouse_demo/keil5/_build/.gitkeep
+
+# fromelf 编译后命令生成的固件
+projects/mouse_demo/keil5/SE73K.bin
+
+# 编译 / 调试日志
+projects/mouse_demo/keil5/*.log
+projects/mouse_demo/keil5/JLinkLog.txt
